      "name": "get_auth_status",
      "description": "Check whether Xbox Live OAuth tokens exist locally and are valid. If not, returns the Microsoft login URL.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "title": "get_auth_statusArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_auth_statusOutput"
      }
    },
    {
      "name": "complete_auth",
      "description": "Complete Microsoft Xbox Live OAuth2 login by exchanging a redirected callback URL (http://localhost:8080/auth/callback?code=...) or raw authorization code and saving tokens locally.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "callback_url_or_code": {
            "title": "Callback Url Or Code",
