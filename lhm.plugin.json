    {
      "name": "get_game_library",
      "description": "Get full Xbox / PC Game Pass game history enriched with exact MinutesPlayed playtime and achievement stats. Set `exclude_win32_footprints=True` to hide third-party Win32 PC games detected by Windows Game Bar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gamertag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gamertag"
          },
          "xuid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Xuid"
          },
          "sort_by": {
            "default": "playtime",
            "enum": [
              "playtime",
              "recent",
              "achievements",
              "name"
            ],
            "title": "Sort By",
            "type": "string"
          },
          "platform": {
            "default": "all",
            "enum": [
              "all",
              "xbox",
              "pc"
            ],
            "title": "Platform",
            "type": "string"
          },
          "game_pass_only": {
            "default": false,
            "title": "Game Pass Only",
            "type": "boolean"
          },
          "tracked_only": {
            "default": false,
            "title": "Tracked Only",
            "type": "boolean"
          },
          "exclude_win32_footprints": {
            "default": false,
            "title": "Exclude Win32 Footprints",
            "type": "boolean"
          },
          "games_only": {
            "default": true,
            "title": "Games Only",
            "type": "boolean"
          },
          "include_detail": {
            "default": false,
            "title": "Include Detail",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "get_game_libraryArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_game_libraryOutput"
      }
    },
